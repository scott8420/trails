<?xml version="1.0" encoding="UTF-8"?>
<!-- Cairn resource bundle. The resource-pipeline paradigm: an app asset carried
     the symbolic way (a currentColor SVG under the freedesktop icon-theme shape)
     so set_icon_name("trails-logo-symbolic") resolves it out of the compiled-in
     binary and GTK recolours it to the theme foreground -- no icon installed on
     the user's disk.

     Gotcha the shape encodes: GTK's icon lookup is RIGID about the trailing
     .../scalable/apps/ path, so the prefix ends there and App::on_activate
     passes only /io/github/scott8420/Trails/icons to add_resource_path (GTK appends
     scalable/apps/ itself). The prefix mirrors the app-id; both move together in
     a one-pass rename. See docs/resources-and-dialog-lifetime.md. -->
<gresources>
  <gresource prefix="/io/github/scott8420/Trails/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="trails-logo-symbolic.svg">icons/scalable/apps/trails-logo-symbolic.svg</file>
    <!-- s003: one per tab, named in core/Tabs.cpp -->
    <file preprocess="xml-stripblanks" alias="trails-tab-overview-symbolic.svg">icons/scalable/apps/trails-tab-overview-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-cpu-symbolic.svg">icons/scalable/apps/trails-tab-cpu-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-memory-symbolic.svg">icons/scalable/apps/trails-tab-memory-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-processes-symbolic.svg">icons/scalable/apps/trails-tab-processes-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-disks-symbolic.svg">icons/scalable/apps/trails-tab-disks-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-network-symbolic.svg">icons/scalable/apps/trails-tab-network-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-gpu-symbolic.svg">icons/scalable/apps/trails-tab-gpu-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-sensors-symbolic.svg">icons/scalable/apps/trails-tab-sensors-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-services-symbolic.svg">icons/scalable/apps/trails-tab-services-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-tab-trails-symbolic.svg">icons/scalable/apps/trails-tab-trails-symbolic.svg</file>
    <!-- 3b (s013): Rouster-style hero orbs, full colour; scripts/make_hero_icons.py -->
    <file preprocess="xml-stripblanks" alias="trails-hero-overview.svg">icons/scalable/apps/trails-hero-overview.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-cpu.svg">icons/scalable/apps/trails-hero-cpu.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-memory.svg">icons/scalable/apps/trails-hero-memory.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-processes.svg">icons/scalable/apps/trails-hero-processes.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-disks.svg">icons/scalable/apps/trails-hero-disks.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-network.svg">icons/scalable/apps/trails-hero-network.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-gpu.svg">icons/scalable/apps/trails-hero-gpu.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-sensors.svg">icons/scalable/apps/trails-hero-sensors.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-services.svg">icons/scalable/apps/trails-hero-services.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-trails.svg">icons/scalable/apps/trails-hero-trails.svg</file>
    <file preprocess="xml-stripblanks" alias="trails-hero-logo.svg">icons/scalable/apps/trails-hero-logo.svg</file>
  </gresource>
  <!-- s003: the skin. Loaded by App::on_activate at APPLICATION priority. -->
  <gresource prefix="/io/github/scott8420/Trails">
    <file>trails.css</file>
    <!-- s015c: the About window's License tab reads the repo's LICENSE -->
    <file alias="LICENSE">../LICENSE</file>
  </gresource>
</gresources>
